{
  "name": "squeakr",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.0",
  "description": "Squeakr — talk to your coding agent. Self-hosted voice bridge for Cursor, Codex, Claude Code and Codewhale CLIs",
  "keywords": [
    "voice",
    "agent",
    "cli",
    "bridge",
    "self-hosted",
    "cursor",
    "codex",
    "claude-code",
    "speech-to-text",
    "text-to-speech",
    "mcp",
    "pwa"
  ],
  "homepage": "https://github.com/dixonSolutions/Squeakr#readme",
  "bugs": {
    "url": "https://github.com/dixonSolutions/Squeakr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixonSolutions/Squeakr.git"
  },
  "author": "dixonSolutions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "squeakr": "bin/squeakr.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "prompts/",
    "scripts/migrate-to-squeakr.sh",
    "web/dist/",
    "!web/dist/vosk/model.tar.gz",
    "config.example.json",
    "cli-config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:web",
    "build:backend": "tsup",
    "build:web": "ng build squeakr-web --configuration production",
    "cli": "node bin/squeakr.mjs",
    "dev": "bash scripts/dev.sh",
    "dev:web": "ng serve squeakr-web",
    "gen-icons": "node scripts/gen-icons.mjs",
    "gen-vapid-keys": "bash scripts/gen-vapid-keys.sh",
    "mobile:sync": "npm run build:web && cd mobile && npm install --legacy-peer-deps && npx cap sync",
    "prepare:vosk": "node scripts/download-vosk-model.mjs",
    "postinstall": "node bin/postinstall.mjs",
    "lint": "eslint src web/src packages/client/src",
    "typecheck": "tsc --noEmit && npx tsc --noEmit -p web/tsconfig.app.json && npx tsc --noEmit -p web/tsconfig.spec.json && npx tsc --noEmit -p packages/client/tsconfig.json",
    "stop": "bash scripts/stop.sh",
    "start:service": "bash scripts/start.sh",
    "start": "NODE_ENV=production node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "LOG_LEVEL=silent node --import tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "test:watch": "LOG_LEVEL=silent node --import tsx --test --watch \"src/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1068.0",
    "@aws-sdk/client-polly": "^3.1070.0",
    "@aws-sdk/client-sts": "^3.1068.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1070.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smithy/node-http-handler": "^4.7.8",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "simple-git": "^3.0.0",
    "strip-ansi": "^7.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/build": "^22.0.1",
    "@angular/cdk": "^22.0.6",
    "@angular/cli": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@capacitor/core": "^7.6.7",
    "@capacitor/push-notifications": "^7.0.6",
    "@openng/optimus-ui": "^1.0.1",
    "@openng/optimus-ui-themes": "^1.0.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@types/better-sqlite3": "^7.0.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "http-proxy": "^1.18.1",
    "nodemon": "^3.1.11",
    "primeicons": "^7.0.0",
    "sharp": "^0.35.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vosk-browser": "^0.0.8",
    "zone.js": "^0.16.2"
  },
  "allowScripts": {
    "better-sqlite3@12.10.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  },
  "optionalDependencies": {
    "@discordjs/voice": "^0.19.2",
    "audio-decode": "^3.12.0",
    "discord.js": "^14.27.0",
    "opusscript": "^0.1.1",
    "vosk-koffi": "^1.1.1"
  }
}
